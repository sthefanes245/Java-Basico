package javaBasico.lista.aula27;

public class Lampada {
	String modelo;
	String tensao;
	int potencia;
	String cor;
	String tipoLuz;
	int garantiaMeses;
	String[] tipos;
	boolean tipoAbajur;
	boolean ligada;
	
	void ligar() { //métodos
		ligada = true;
	}

	void desligar() {
		ligada = false;
	}
	
	void mostrarEstado() {
		if(ligada) {
			System.out.println("Lampada está ligada");
			
		}else {
			System.out.println("Lampada está desligada");
		}
	}
}
